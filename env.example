# Primary generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Failsafe generation (OpenAI-compatible). NVIDIA free-tier example:
#   https://build.nvidia.com → get API key
FALLBACK_LLM_API_KEY=
# or: NVIDIA_API_KEY=
FALLBACK_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_LLM_MODEL=meta/llama-3.1-8b-instruct

# Embeddings — local default EmbeddingGemma 2
EMBEDDING_MODEL=google/embeddinggemma-2
# Matryoshka dim: 0 = full (default). Try 512, 256, or 128 to reduce cost.
# After changing, rebuild: corpus_builder rebuild-index + rag reset-index + re-ingest.
EMBEDDING_DIM=0

# Optional Hugging Face (rate limits / gated models)
HF_TOKEN=
